# Copy to .env and set a real password before the first `docker compose up`.
# Postgres only ever sees it inside the compose network; nothing else needs it.
FURY_DB_PASSWORD=change-me

# Which release of the server image to run (ghcr.io/furyteamtop/fury-server).
# Empty means the newest. Pin it to the version your team's apps are on, e.g.
# FURY_VERSION=0.2.21, and change it deliberately when you update.
FURY_VERSION=

# Mail, to confirm that an invitation is redeemed by the owner of the invited
# address: six digits by email. Empty means off, and then a code works for
# whoever types it first. docs/13, "Подтверждение почты".
#   FURY_SMTP_URL=smtps://user:password@smtp.example.com:465
#   FURY_MAIL_FROM=Fury <noreply@example.com>
FURY_SMTP_URL=
FURY_MAIL_FROM=
