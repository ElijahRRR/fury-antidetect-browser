+// Fury: tells the AppController when the first browser window exists, for a
+// launch whose window only comes after -applicationDidFinishLaunching:. A
+// profile with a session to restore is one: its windows are not there yet
+// when AppKit finishes launching.
+class FuryFirstBrowserObserver : public BrowserCollectionObserver {
+ public:
+  FuryFirstBrowserObserver() {
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+  }
+  FuryFirstBrowserObserver(const FuryFirstBrowserObserver&) = delete;
+  FuryFirstBrowserObserver& operator=(const FuryFirstBrowserObserver&) =
+      delete;
+  ~FuryFirstBrowserObserver() override = default;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    if (!released_) {
+      released_ = true;
+      [AppController.sharedController furyQuitWithLastWindow];
+    }
+  }
+
+ private:
+  bool released_ = false;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
